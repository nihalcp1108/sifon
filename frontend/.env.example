# Sifon Frontend Environment Configuration Example
# Copy this file to .env before starting the development server or building the application.
# Note: Vite embeds VITE_* variables into the bundle at build time. Restart Vite after changing these values.

# Centralized Backend API URL (including route prefix, e.g. /api/v1)
VITE_API_URL=http://localhost:5000/api/v1

# Application display name
VITE_APP_NAME=Sifon
