# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas)
# Replace placeholders with your Atlas database user, password (URL-encoded), and cluster host:
# Example: mongodb+srv://sifon_user:P%40ssw0rd@cluster0.abcde.mongodb.net/sifon?retryWrites=true&w=majority
MONGODB_URI=MONGODB_URI=mongodb+srv://sifon:sifon2026@cluster0.4ox5m7o.mongodb.net/sifon?retryWrites=true&w=majority

# Frontend Origin for CORS (comma-separated if multiple origins)
FRONTEND_URL=http://localhost:5173

# Authentication & Security
# Generate a strong 64-character secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=YOUR_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS
JWT_EXPIRES_IN=7d
COOKIE_SECRET=YOUR_COOKIE_SIGNING_SECRET_KEY

# Timezone Configuration
TIMEZONE=Asia/Kolkata

# Initial Admin Credentials (Optional: used for automatic first-time bootstrap or seed scripts)
INITIAL_ADMIN_EMAIL=admin@sifon.local
INITIAL_ADMIN_PASSWORD=Admin@Sifon2026!
INITIAL_ADMIN_NAME=Super Admin
